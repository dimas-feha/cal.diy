**/.turbo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Yarn internals — not needed inside Docker, saves ~200MB from build context
.yarn/cache
.yarn/install-state.gz

